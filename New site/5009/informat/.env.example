# ==========================================================
# Informat - Environment Variables
# Copy this file to ".env" for local development.
# On Render, set these under Dashboard > your service > Environment.
# NEVER commit a real ".env" file to GitHub.
# ==========================================================

# MongoDB connection string (MongoDB Atlas free tier recommended)
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/informat?retryWrites=true&w=majority
DATABASE_URL=

# Long random string used to sign session cookies (32+ random characters)
SESSION_SECRET=

# The public URL of your deployed site (no trailing slash)
# Example: https://informat.onrender.com
SITE_URL=

# Port the app listens on. Render sets this automatically - leave blank on Render.
PORT=3000

# Initial admin account, used only once by "npm run create-admin"
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# One-time browser-based admin setup, for hosts with no shell access (e.g. Render's
# free tier). Set this to any long random string, deploy, then visit:
#   https://YOUR-SITE-NAME.onrender.com/admin/setup?token=THIS_VALUE
# to create your admin account from a normal browser. The page permanently
# disables itself the moment one admin account exists, so it's safe to leave
# this variable set afterwards.
SETUP_TOKEN=

# Google Search Console verification.
# Use ONE of the two methods below (HTML file is simplest on Render).
# 1) HTML file method: paste the verification code from the filename
#    "google1234567890abcdef.html" (just the code, no .html extension)
GOOGLE_SITE_VERIFICATION_FILE=
# 2) Meta tag method: paste the "content" value Google gives you
GOOGLE_SITE_VERIFICATION_META=

# Node environment
NODE_ENV=development
