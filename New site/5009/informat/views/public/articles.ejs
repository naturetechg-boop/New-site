<div class="container">
  <div class="page-header">
    <h1>Articles</h1>
    <p>Every story we've published, newest first.</p>
  </div>

  <% if (articles.length === 0) { %>
    <div class="empty-state"><p>No articles published yet. Check back soon.</p></div>
  <% } else { %>
    <div class="article-grid">
      <% articles.forEach(function(article) { %>
        <%- include('../partials/article-card', { article }) %>
      <% }) %>
    </div>
    <%- include('../partials/pagination') %>
  <% } %>
</div>
