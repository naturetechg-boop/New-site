<% if (typeof activeAnnouncement !== 'undefined' && activeAnnouncement) { %>
  <div class="announcement-bar style-<%= activeAnnouncement.style %>">
    <%= activeAnnouncement.message %>
    <% if (activeAnnouncement.linkUrl) { %>
      <a href="<%= activeAnnouncement.linkUrl %>"><%= activeAnnouncement.linkText || 'Learn more' %></a>
    <% } %>
  </div>
<% } %>

<header class="site-header">
  <div class="container masthead">
    <a href="/" class="wordmark"><%= site.siteName %></a>
    <span class="masthead-tagline"><%= site.tagline %></span>
    <form class="masthead-search" action="/search" method="GET" role="search">
      <input type="search" name="q" placeholder="Search articles…" aria-label="Search articles" value="<%= typeof query !== 'undefined' ? query : '' %>">
    </form>
  </div>
  <nav class="main-nav container" aria-label="Primary">
    <ul>
      <li><a href="/" class="<%= currentPath === '/' ? 'is-active' : '' %>">Home</a></li>
      <li><a href="/articles" class="<%= currentPath === '/articles' ? 'is-active' : '' %>">Articles</a></li>
      <% navCategories.forEach(function(cat) { %>
        <li><a href="/category/<%= cat.slug %>" class="<%= currentPath === '/category/' + cat.slug ? 'is-active' : '' %>"><%= cat.name %></a></li>
      <% }) %>
      <li><a href="/about" class="<%= currentPath === '/about' ? 'is-active' : '' %>">About</a></li>
      <li><a href="/contact" class="<%= currentPath === '/contact' ? 'is-active' : '' %>">Contact</a></li>
    </ul>
  </nav>
</header>
